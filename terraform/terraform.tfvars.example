# Example Variable Values for Enterprise Azure Infrastructure
# Copy this file to `terraform.tfvars` and adjust values as needed:
# cp terraform.tfvars.example terraform.tfvars

prefix      = "enterprise"
environment = "prod"
location    = "eastus"

hub_vnet_address_space   = ["10.0.0.0/16"]
firewall_subnet_prefix   = "10.0.1.0/26"
bastion_subnet_prefix    = "10.0.2.0/26"
gateway_subnet_prefix    = "10.0.3.0/27"
management_subnet_prefix = "10.0.4.0/24"

spoke_vnet_address_space = ["10.1.0.0/16"]
web_subnet_prefix        = "10.1.1.0/24"
app_subnet_prefix        = "10.1.2.0/24"
db_subnet_prefix         = "10.1.3.0/24"

tags = {
  Project     = "Enterprise-Azure-Infrastructure"
  Environment = "Production"
  ManagedBy   = "Terraform"
  Owner       = "Aakash Trivedi"
  CostCenter  = "Cloud-Engineering-101"
}
